{
  "ConnectionStrings": {
    "Default": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Estehlaky",
    "Audience": "Estehlaky.Client",
    "Key": "",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "RefreshTokenAbsoluteDays": 90,
    "ReuseGraceSeconds": 10,
    "MaxActiveSessions": 10,
    "ClockSkewSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "EmailServices": {
    "Resend": {
      "ApiKey": "",
      "FromEmail": "estehlaky@dyer-kw.com",
      "FromName": "Estehlaky Staging"
    }
  },
  "PasswordResetOtp": {
    "Length": 6,
    "ExpirationMinutes": 5,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60,
    "HashingKey": ""
  },
  "SentSms": {
    "BaseUrl": "https://api.sent.dm/",
    "ApiKey": "",
    "OtpTemplateId": ""
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "",
    "InstanceName": "Estehlaky:Staging:"
  },
  "FileStorage": {
    "Provider": "Local",
    "BasePath": "uploads/staging",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".pdf"
    ]
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowMinutes": 1,
    "QueueLimit": 0
  },
  "Swagger": {
    "Enabled": true,
    "Title": "Staging",
    "Version": "v1"
  },
  "HealthChecks": {
    "Database": true,
    "Redis": false
  },
  "ExternalApis": {
    "ExampleApi": {
      "Enabled": false,
      "BaseUrl": "",
      "ApiKey": "",
      "TimeoutSeconds": 30
    }
  },
  "Application": {
    "Name": "Estehlaky",
    "BaseUrl": "",
    "SupportEmail": "estehlaky@dyer-kw.com",
    "DefaultCulture": "en",
    "DefaultTimeZone": "Egypt Standard Time"
  }
}