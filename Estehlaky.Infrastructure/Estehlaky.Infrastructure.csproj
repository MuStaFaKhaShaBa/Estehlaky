<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Resend" Version="0.27.0" />
    <PackageReference Include="Sentdm" Version="0.48.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Estehlaky.Application\Estehlaky.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\Migrations\" />
    <Folder Include="Seed\" />
  </ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Seed\Data\roles.json">
			<LogicalName>Estehlaky.Infrastructure.Seed.Data.roles.json</LogicalName>
		</EmbeddedResource>

		<EmbeddedResource Include="Seed\Data\users.json">
			<LogicalName>Estehlaky.Infrastructure.Seed.Data.users.json</LogicalName>
		</EmbeddedResource>
	</ItemGroup>
</Project>
